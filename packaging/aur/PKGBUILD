# Maintained by the Muffle project; tested by the release validation workflow.
pkgname=muffle
pkgver=0.1.2
pkgrel=1
pkgdesc='Suppress successful command output and show failure details'
arch=('x86_64')
url='https://github.com/Thavarshan/muffle'
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cmake' 'python')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('14da66c1f20f90dd5d4e3e5c02c15dbfe5f2bcdecb5202c01b793c602f969eee')

build() {
    cmake -S "$srcdir/muffle-$pkgver" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --parallel 2
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
